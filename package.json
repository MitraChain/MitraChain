{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format:write": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check .",
    "db:types": "pnpx supabase gen types typescript --project-id zhwegqlelhhdirlmilcq > packages/supabase/types.ts"
