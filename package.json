    "prettier-plugin-tailwindcss": "^0.6.14",
    "supabase": "^2.47.2",
    "turbo": "^2.5.5",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6"
